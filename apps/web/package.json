{
  "name": "saltline-arena-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "wasm": "cd ../../server/game-wasm && wasm-pack build --target web --release --out-dir ../../apps/web/src/wasm && rm -f ../../apps/web/src/wasm/.gitignore",
    "game": "node game/build.mjs",
    "predev": "node game/build.mjs",
    "prebuild": "node game/build.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.57.19"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "three": "^0.180.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
